# Copy to .env — both uvicorn (app.main) and `python -m app.recheck` load it.
# All values are optional; commented lines show the defaults.

# --- Storage ---------------------------------------------------------------

# Full SQLAlchemy connection URL. When set, all stats are stored in this
# database instead of the local SQLite file. `postgresql://` and
# `postgres://` URLs use the psycopg v3 driver automatically.
# PHP2SHELL_DATABASE_URL=postgresql://php2shell:secret@localhost:5432/php2shell

# SQLite file used only when PHP2SHELL_DATABASE_URL is not set.
# PHP2SHELL_DB=./php2shell-stats.db

# When truthy (1/true/yes/on), the whole backend uses the active detector
# (app/active.py): /api/v1/check actively investigates each submitted host
# (falling back to the forwarded headers if the probe fails) and the NextDNS
# input upgrades from header-only probes to full fingerprinting. The cron
# recheck is always active regardless.
# PHP2SHELL_ACTIVE=false

# --- NextDNS stream input (optional) ----------------------------------------

# Both are required to enable the stream.
# NEXTDNS_API_KEY=
# NEXTDNS_PROFILE=

# NEXTDNS_BASE_URL=https://api.nextdns.io
# NEXTDNS_PROBE_CONCURRENCY=4
# NEXTDNS_CHECK_TTL_HOURS=12
