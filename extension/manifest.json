{
  "manifest_version": 3,
  "name": "PHP2Shell Guard",
  "version": "1.0.0",
  "description": "Passively detects whether the site you are browsing runs a PHP version vulnerable to php2shell (CVE-2026-109618 / CVE-2026-109619).",
  "permissions": ["webRequest", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
